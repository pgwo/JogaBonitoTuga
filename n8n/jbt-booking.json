{
  "name": "JogaBonitoTuga - booking (DEMO)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "jbt-booking",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "webhook-booking",
      "name": "Webhook booking",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "jbt-booking-webhook"
    },
    {
      "parameters": {
        "jsCode": "const raw=$input.first().json.body;\nconst b=typeof raw==='string'?JSON.parse(raw):(raw||{});\nconst email=String(b.email||'').trim();\nconst name=String(b.name||'').trim();\nconst gameId=String(b.gameId||'').trim();\nif (!name || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email) || !gameId) return [{json:{success:false,message:'Nome, email e jogo são obrigatórios.'}}];\n// DEMONSTRAÇÃO: pedido recebido nesta execução; nenhuma vaga é reservada.\nreturn [{json:{success:true,status:'received',message:'Pedido recebido para análise. Ainda não é uma inscrição confirmada.',reference:'demo-'+Date.now()}}];"
      },
      "id": "logic-booking",
      "name": "Lógica booking (DEMO)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "firstIncomingItem",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              },
              {
                "name": "Content-Type",
                "value": "application/json; charset=utf-8"
              }
            ]
          }
        }
      },
      "id": "respond-booking",
      "name": "Resposta booking",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        720,
        300
      ]
    }
  ],
  "connections": {
    "Webhook booking": {
      "main": [
        [
          {
            "node": "Lógica booking (DEMO)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Lógica booking (DEMO)": {
      "main": [
        [
          {
            "node": "Resposta booking",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "pinData": {},
  "tags": []
}
