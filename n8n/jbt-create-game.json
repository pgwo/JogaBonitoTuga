        "jsCode": "const raw=$input.first().json.body;\nconst b=typeof raw==='string'?JSON.parse(raw):(raw||{});\nconst sports=['Futebol','Futsal','Basquetebol','Padel'];\nconst email=String(b.email||'').trim();\nif (!String(b.name||'').trim() || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email) || !sports.includes(b.sport) || !String(b.city||'').trim() || !String(b.venue||'').trim() || !/^\\d{4}-\\d{2}-\\d{2}$/.test(String(b.date||'')) || !/^\\d{2}:\\d{2}$/.test(String(b.time||'')) || !(Number(b.capacity)>0)) return [{json:{success:false,message:'Preenche todos os campos obrigatórios com valores válidos.'}}];\n// DEMONSTRAÇÃO: não grava o jogo numa base de dados.\nreturn [{json:{success:true,status:'received',message:'Pedido de criação recebido para análise. O jogo ainda não foi publicado.',reference:'demo-'+Date.now()}}];"
      },
